# Opcional: habilita o provedor oficial DeepL no modo híbrido.
DEEPL_API_KEY=
# Use false se a chave pertencer ao plano DeepL Pro.
DEEPL_USE_FREE=true

# Opcional: forçar um modelo Piper específico (senão o Loon baixa o certo sozinho).
# PIPER_MODEL=C:\modelos\pt_BR-faber-medium.onnx
PIPER_MODEL=

# Opcional: modo "IA" (tradução por LLM com contexto da conversa).
# Provedores: ollama, lmstudio (locais, sem chave), groq, openai, gemini, openrouter.
# Exemplo local:  LLM_PROVIDER=ollama  e  ollama pull qwen2.5:3b
LLM_PROVIDER=ollama
# Vazio = modelo padrão do provedor (qwen2.5:3b, qwen/qwen3.8-27b, gpt-4o-mini...).
LLM_MODEL=
# Necessária só para provedores na nuvem.
LLM_API_KEY=
# Vazio = endereço padrão do provedor. Qualquer servidor compatível com OpenAI serve.
LLM_BASE_URL=
# Segundos até desistir e cair para Argos/DeepL/Google.
LLM_TIMEOUT=4

# Não registra conteúdo de conversas por padrão.
LOON_LOG_TRANSCRIPTS=false
